# Copia este archivo a `.env` (que sí está en .gitignore) y pon los valores
# reales de tu Supabase autoalojado. Solo la clave "anon" va aquí — la
# service_role NUNCA debe vivir en el front (esa se queda en
# servicio-procesos, del lado del servidor).

VITE_SUPABASE_URL=http://localhost:8000
VITE_SUPABASE_ANON_KEY=pon-aqui-la-anon-key-real

# Servicio de procesos (solo lo usa la pantalla de Gestión de usuarios, para
# el alta de cuentas — POST /admin/alta-usuario). Puerto por defecto de
# `./scripts/levantar.sh` en el backend: 8001.
VITE_SERVICIO_PROCESOS_URL=http://localhost:8001
